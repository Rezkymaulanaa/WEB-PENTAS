# Salin file ini menjadi .env lalu isi nilainya.

# Kunci rahasia untuk token login. Buat yang acak, misalnya dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Koneksi database MySQL: mysql+pymysql://USER:PASSWORD@HOST/NAMA_DATABASE
DATABASE_URL=mysql+pymysql://root:@localhost/db_pentas

# Alamat frontend yang boleh mengakses API (pisahkan dengan koma jika lebih dari satu)
FRONTEND_ORIGIN=http://localhost:5173

# Masa berlaku login dalam detik (default 8 jam)
TOKEN_MAX_AGE=28800

# ---- Email (opsional) ----
# Dipakai untuk notifikasi status ke mahasiswa dan form Kontak.
# Untuk Gmail: aktifkan 2-Step Verification, lalu buat App Password di
# https://myaccount.google.com/apppasswords dan tempel di MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Penerima pesan dari form Kontak (default: MAIL_USERNAME)
ADMIN_EMAIL=
